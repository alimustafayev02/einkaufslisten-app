# Symfony Konfiguration 
# Diese Datei dient als Vorlage. Kopiere sie zu .env und passe die Werte an. 
APP_ENV=dev 
APP_SECRET=ChangeMeToARandomSecret 
APP_DEBUG=1 
 
# Datenbank-Verbindung 
# Beim Docker-Setup wird DATABASE_URL durch docker-compose.yml gesetzt. 
DATABASE_URL="mysql://app_user:app_password@database:3306/einkaufslisten?serverVersion=8.0.32&charset=utf8mb4"
