{% extends 'base.html.twig' %}

{% block title %}Meine Einkaufslisten{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">
        <i class="bi bi-list-check text-primary"></i> Meine Einkaufslisten
    </h1>
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createListModal">
        <i class="bi bi-plus-lg"></i> Neue Liste
    </button>
</div>

{% if lists is empty %}
    <div class="card">
        <div class="card-body">
            <div class="empty-state">
                <i class="bi bi-cart-x"></i>
                <h5>Noch keine Einkaufslisten</h5>
                <p>Erstellen Sie Ihre erste Einkaufsliste, um loszulegen.</p>
                <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createListModal">
                    <i class="bi bi-plus-lg"></i> Erste Liste erstellen
                </button>
            </div>
        </div>
    </div>
{% else %}
    <div class="row g-3">
        {% for list in lists %}
            <div class="col-md-6 col-lg-4">
                <div class="card card-hoverable h-100">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="card-title mb-0">
                                <a href="{{ path('list_detail', { id: list.id }) }}" class="text-decoration-none text-dark stretched-link">
                                    {{ list.name }}
                                </a>
                            </h5>
                            <button class="btn-icon delete position-relative" style="z-index: 2;"
                                    onclick="event.stopPropagation(); deleteList({{ list.id }}, '{{ list.name|e('js') }}')"
                                    title="Liste löschen">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                        <p class="text-muted small mb-2">
                            <i class="bi bi-calendar3"></i>
                            {{ list.createdAt|date('d.m.Y H:i') }}
                        </p>
                        <div class="mt-auto">
                            <span class="badge bg-light text-dark">
                                <i class="bi bi-basket2"></i>
                                {{ list.items|length }} Artikel
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
{% endif %}

{# Modal: Neue Einkaufsliste erstellen #}
<div class="modal fade" id="createListModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="bi bi-plus-circle text-primary"></i> Neue Einkaufsliste
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label for="newListName" class="form-label">Name der Liste</label>
                    <input type="text" class="form-control" id="newListName" placeholder="z.B. Wocheneinkauf" required>
                </div>
                <div class="mb-3">
                    <label class="form-label">Erste Einträge (optional)</label>
                    <div id="initialItems"></div>
                    <button type="button" class="btn btn-sm btn-outline-secondary mt-2" onclick="addInitialItemRow()">
                        <i class="bi bi-plus"></i> Eintrag hinzufügen
                    </button>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Abbrechen</button>
                <button type="button" class="btn btn-primary" onclick="createList()">
                    <i class="bi bi-check2"></i> Erstellen
                </button>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
    function addInitialItemRow() {
        const container = document.getElementById('initialItems');
        const row = document.createElement('div');
        row.className = 'input-group mb-2';
        row.innerHTML = `
            <input type="text" class="form-control item-name" placeholder="Artikelname">
            <input type="number" class="form-control item-quantity" placeholder="Menge" value="1" min="1" style="max-width: 90px;">
            <button class="btn btn-outline-danger" type="button" onclick="this.parentElement.remove()">
                <i class="bi bi-x"></i>
            </button>
        `;
        container.appendChild(row);
    }

    async function createList() {
        const name = document.getElementById('newListName').value.trim();
        if (!name) {
            showToast('Bitte geben Sie einen Namen ein.', 'error');
            return;
        }

        const items = [];
        document.querySelectorAll('#initialItems .input-group').forEach(row => {
            const itemName = row.querySelector('.item-name').value.trim();
            const quantity = parseInt(row.querySelector('.item-quantity').value) || 1;
            if (itemName) items.push({ name: itemName, quantity });
        });

        try {
            await apiCall('/api/lists', 'POST', { name, items });
            showToast('Einkaufsliste erfolgreich erstellt.', 'success');
            setTimeout(() => window.location.reload(), 500);
        } catch (err) {
            showToast(err.message, 'error');
        }
    }

    async function deleteList(id, name) {
        if (!confirm(`Möchten Sie die Liste "${name}" wirklich löschen?`)) return;
        try {
            await apiCall(`/api/lists/${id}`, 'DELETE');
            showToast('Liste gelöscht.', 'success');
            setTimeout(() => window.location.reload(), 300);
        } catch (err) {
            showToast(err.message, 'error');
        }
    }
</script>
{% endblock %}
